[
 {
  "id": "market",
  "step": 1,
  "title": "Set Your Market And Video Language",
  "scenes": [
   {
    "say": "Start in Settings, under Content Preferences.",
    "do": [
     {
      "go": "/create"
     },
     "|",
     {
      "nav": "Settings"
     },
     {
      "scroll": "#preferences"
     }
    ]
   },
   {
    "say": "Pick the language your videos are spoken in, and your time zone.",
    "do": [
     {
      "hover": "#preferences select"
     },
     {
      "wait": 1200
     },
     {
      "hover": "#preferences select >> nth=1"
     }
    ]
   },
   {
    "say": "Then enter your city and state.",
    "do": [
     {
      "hover": "ph:City (e.g. Austin)"
     },
     {
      "wait": 900
     },
     {
      "hover": "ph:State (e.g. TX)"
     }
    ]
   },
   {
    "say": "Press Save Preferences.",
    "do": [
     {
      "hover": "btn:Save Preferences"
     }
    ]
   },
   {
    "say": "SparkReels uses your market for live local research, trending topics, and ideas with your town already filled in.",
    "do": [
     {
      "hover": "#preferences h3",
      "fx": 0.3
     }
    ]
   }
  ]
 },
 {
